FoamFile {
    version 2.0;
    format ascii;
    class dictionary;
    object fvSchemes;
}
ddtSchemes {
    default steadyState;
}
gradSchemes {
    default cellLimited leastSquares 1.0;
}
divSchemes {
    default Gauss linear;
    div(phi,U) bounded Gauss localBlended upwind linearUpwindV grad(U);
    div(phi,K) bounded Gauss linear;
    div(phi,h) bounded Gauss upwind;
    div(phi,e) bounded Gauss linearUpwind limitedGrad;
    div(phi,k) bounded Gauss upwind;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
    div(phi,omega) bounded Gauss upwind;
}
laplacianSchemes {
    default Gauss linear limited corrected 0.5;
    laplacian((rho*DkEff),k) Gauss linear limited corrected 0.5;
    laplacian(alphaEff,h) Gauss linear limited corrected 0.5;
    laplacian((rho*nuEff),U) Gauss linear limited corrected 0.5;
    laplacian(alphaEff,e) Gauss linear limited corrected 0.5;
    laplacian((rho*DomegaEff),omega) Gauss linear limited corrected 0.5;
    laplacian(rhorAUf,p) Gauss linear limited corrected 0.5;
}
interpolationSchemes {
    default linear;
}
snGradSchemes {
    default limited 0.5;
}
wallDist {
    method meshWave;
}
fluxRequired {
    default no;
    p ;
}
