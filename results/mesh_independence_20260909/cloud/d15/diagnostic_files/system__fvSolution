FoamFile {
    version 2.0;
    format ascii;
    class dictionary;
    object fvSolution;
}
solvers {
    U {
        solver PBiCGStab;
        tolerance 1e-08;
        relTol 0.01;
        minIter 1;
        maxIter 1000;
        preconditioner DILU;
    }
    p {
        solver GAMG;
        tolerance 1e-07;
        relTol 0.01;
        minIter 1;
        maxIter 1000;
        smoother GaussSeidel;
        nPreSweeps 2;
        nPostSweeps 1;
        cacheAgglomeration on;
        agglomerator faceAreaPair;
        nCellsInCoarsestLevel 100;
        mergeLevels 1;
    }
    h {
        solver smoothSolver;
        tolerance 1e-07;
        relTol 0.01;
        minIter 1;
        maxIter 1000;
        smoother GaussSeidel;
    }
    e {
        solver smoothSolver;
        tolerance 1e-07;
        relTol 0.01;
        minIter 1;
        maxIter 1000;
        smoother GaussSeidel;
    }
    k {
        solver PBiCGStab;
        tolerance 1e-08;
        relTol 0.01;
        minIter 1;
        maxIter 1000;
        preconditioner DILU;
    }
    omega {
        solver PBiCGStab;
        tolerance 1e-08;
        relTol 0.01;
        minIter 1;
        maxIter 1000;
        preconditioner DILU;
    }
}
relaxationFactors {
    fields {
        p 0.3;
        rho 0.05;
    }
    equations {
        U 0.7;
        h 0.7;
        e 0.1;
        k 0.7;
        omega 0.7;
    }
}
SIMPLE {
    nNonOrthogonalCorrectors 1;
    pRefCell 0;
    pRefValue 97690.0;
    residualControl {
        U 1e-05;
        "p.*" 1e-05;
        k 1e-05;
        omega 1e-05;
    }
    pMin 20000.0;
    pMax 300000.0;
}
