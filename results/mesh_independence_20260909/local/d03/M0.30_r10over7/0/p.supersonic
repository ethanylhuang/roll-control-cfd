FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/flowSettings"

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform $pInf;

boundaryField
{
    inlet           // supersonic inflow: everything prescribed
    {
        type            fixedValue;
        value           uniform $pInf;
    }

    outlet          // supersonic outflow: nothing prescribed
    {
        type            zeroGradient;
    }

    sides
    {
        type            zeroGradient;
    }

    "rocket.*"
    {
        type            zeroGradient;
    }
}

// ************************************************************************* //
