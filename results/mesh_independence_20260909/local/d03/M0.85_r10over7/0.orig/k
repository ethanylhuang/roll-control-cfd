FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/flowSettings"

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $kInf;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $kInf;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform $kInf;
        value           uniform $kInf;
    }

    sides
    {
        type            inletOutlet;
        inletValue      uniform $kInf;
        value           uniform $kInf;
    }

    "rocket.*"
    {
        type            kqRWallFunction;
        value           uniform $kInf;
    }
}

