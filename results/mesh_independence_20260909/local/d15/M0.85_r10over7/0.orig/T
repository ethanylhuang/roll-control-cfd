FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/flowSettings"

dimensions      [0 0 0 1 0 0 0];

internalField   uniform $Tinf;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $Tinf;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform $Tinf;
        value           uniform $Tinf;
    }

    sides
    {
        type            inletOutlet;
        inletValue      uniform $Tinf;
        value           uniform $Tinf;
    }

    "rocket.*"      // adiabatic
    {
        type            zeroGradient;
    }
}

