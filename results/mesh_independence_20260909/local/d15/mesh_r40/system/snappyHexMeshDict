FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// v4 SimScale-matched refinement. Base cell 0.064 m; levels are halvings:
// L2=16mm (wake), L4=4mm (body), L5=2mm (fins, tab), L8=0.25mm (slot faces,
// giving >=3 cells across the 0.75 mm gap). Surface/feature levels and the
// per-deflection boxes come from meshSettings (generated by run_sweep.py:
// config "levels" normally, an override set for --mesh-check).

#include "meshSettings"

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    rocket_body.stl  { type triSurfaceMesh; name rocket_body; }
    rocket_fins.stl  { type triSurfaceMesh; name rocket_fins; }
    rocket_tab.stl   { type triSurfaceMesh; name rocket_tab; }
    rocket_slot.stl  { type triSurfaceMesh; name rocket_slot; }

    wakeBox
    {
        type searchableBox;
        min ($wakeMinX $wakeMinY $wakeMinZ);
        max ($wakeMaxX $wakeMaxY $wakeMaxZ);
    }
    slotBox
    {
        type searchableBox;
        min ($slotMinX $slotMinY $slotMinZ);
        max ($slotMaxX $slotMaxY $slotMaxZ);
    }
}

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      8000000;
    minRefinementCells  100;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;

    features
    (
        { file "rocket_fins.eMesh";  level $finsFeatLevel; }
        { file "rocket_tab.eMesh";   level $tabFeatLevel; }
        { file "rocket_slot.eMesh";  level $slotFeatLevel; }
    );

    refinementSurfaces
    {
        rocket_body { level ($bodyLevel $bodyLevel); patchInfo { type wall; inGroups (rocketGroup); } }
        rocket_fins { level ($finsLevel $finsLevel); patchInfo { type wall; inGroups (rocketGroup); } }
        rocket_tab  { level ($tabLevel $tabLevel);   patchInfo { type wall; inGroups (rocketGroup); } }
        rocket_slot { level ($slotLevel $slotLevel); patchInfo { type wall; inGroups (rocketGroup); } }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        wakeBox { mode inside; levels ((1E15 2)); }
        slotBox { mode inside; levels ((1E15 $slotLevel)); }
    }

    locationInMesh (0.4 0.4 0.0);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      30;
    nRelaxIter      5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes       true;
    expansionRatio      1.3;
    finalLayerThickness 0.4;
    minThickness        0.3;

    layers
    {
        // lighter settings (2026-09-02): global minThickness 0.3, tab gets
        // the same 4-stack as the fins, body feature edges are not extracted
        // (see surfaceFeatureExtractDict), minRefinementCells 100
        rocket_body { nSurfaceLayers 4; }
        rocket_fins { nSurfaceLayers 4; }
        rocket_tab  { nSurfaceLayers 4; }
        rocket_slot { nSurfaceLayers 0; }   // 0.75 mm gap cannot host a stack
    }

    nGrow               0;
    featureAngle        150;
    slipFeatureAngle    30;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
    nRelaxedIter        20;
}

meshQualityControls
{
    maxNonOrtho         70;   // SimScale meshQualityControls
    maxBoundarySkewness 4;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-13;
    minTetQuality       1e-15;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      0.001;
    minFaceWeight       0.05;
    minVolRatio         0.01;
    minTriangleTwist    -1;
    nSmoothScale        4;
    errorReduction      0.75;

    relaxed
    {
        maxNonOrtho     75;
    }
}

writeFlags
(
    scalarLevels
);

mergeTolerance 1e-6;

