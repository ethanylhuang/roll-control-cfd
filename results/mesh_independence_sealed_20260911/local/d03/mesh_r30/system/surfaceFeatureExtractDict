FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeatureExtractDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// includedAngle 150 per the v4 spec (edges sharper than 30 deg captured)

// body edges deliberately not extracted (lighter mesh, 2026-09-02)

rocket_fins.stl
{
    extractionMethod extractFromSurface;
    includedAngle    150;
    subsetFeatures { nonManifoldEdges no; openEdges yes; }
}

rocket_tab.stl
{
    extractionMethod extractFromSurface;
    includedAngle    150;
    subsetFeatures { nonManifoldEdges no; openEdges yes; }
}

rocket_slot.stl
{
    extractionMethod extractFromSurface;
    includedAngle    150;
    subsetFeatures { nonManifoldEdges no; openEdges yes; }
}

