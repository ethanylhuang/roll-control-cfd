FoamFile {
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}
application simscaleRhoPimpleFoam;
startFrom startTime;
stopAt writeNow;
purgeWrite 0;
writeFormat ascii;
writePrecision 12;
writeCompression on;
timeFormat general;
timePrecision 16;
runTimeModifiable yes;
deltaT 4e-06;
