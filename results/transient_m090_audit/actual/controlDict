        minNonOrthogonality 85;
        switchSkewness yes;
        maxSkewness 4;
        minSkewness 6;
        switchGradCc no;
        switchResiduals no;
        switchCo no;
        switchFaceWeight no;
    }
    sigHandler {
        type openFoamWriteOldTimesOnSignal;
        sleepSecondsBeforeReraising 60;
        numberOfTimestepsToStore 1;
        writeCurrent false;
        sigFPE true;
        sigSEGV false;
        sigABRT true;
        sigINT false;
        sigQUIT true;
    }
    flexibleWriter {
        type flexibleWriter;
        clockTimeLimit 1000000.0;
        fracTime -1.0;
    }
    divergenceHandler {
        type divergenceHandler;
        nItersToSkip 50;
        T -100000.0 100000.0;
        U 10000000.0;
        p -1000000000000000.0 1000000000000000.0;
        rho -100000.0 100000.0;
        scalarFields (T p rho);
        vectorFields (U);
        active yes;
        minTimeStep 1e-10;
    }
